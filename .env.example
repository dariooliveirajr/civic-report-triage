# Copy to .env and fill in. Never commit .env.

# API
# 0.0.0.0 = all interfaces (needed in a container, default value); 127.0.0.1 = this machine only
# Set HOST=127.0.0.1 locally to keep the API off the LAN  network
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Postgres + pgvector (docker-compose.yml)
DATABASE_URL=postgres://triage:triage@localhost:5432/triage

# Reply drafts: LLM API (provider chosen in issue #8)
LLM_API_KEY=
LLM_MODEL=

# Embeddings: embedding API (provider chosen in issue #8)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
